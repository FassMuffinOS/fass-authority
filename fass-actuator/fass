#!/usr/bin/env bash
set -euo pipefail

CMD="${1:-}"
ARG="${2:-}"

die() {
  echo "FASS ERROR: $1"
  exit 1
}

canon_dirty() {
  git status --porcelain \
    | grep -E '^( M|\?\?)' \
    | grep -v 'canon/WITNESS_LOG.jsonl' \
    | grep -v '^ M docs/CANON/' \
    | grep -v '^ M canon/.*\.hash' \
    | grep -v '^ M canon/ACTIVE_CANON' \
    >/dev/null
}

require_clean_canon() {
  if canon_dirty; then
    die "Canon scope not clean"
  fi
}

case "$CMD" in

  status)
    echo "Active Canon:"
    cat canon/ACTIVE_CANON
    ;;

  verify)
    node --input-type=module -e "import './index.js'; console.log('CANON OK');"
    ;;

  freeze)
    [ -z "$ARG" ] && die "Usage: fass freeze X.Y"

    VERSION="CANON_V${ARG}"
    HASH_FILE="canon/${VERSION//./_}.hash"

    echo "→ Verifying canon integrity"
    node --input-type=module -e "import './index.js';"

    require_clean_canon

    echo "→ Freezing $VERSION"

    find docs/CANON -type f -print0 \
      | sort -z \
      | xargs -0 sha256sum \
      | sha256sum \
      | awk '{print $1}' > "$HASH_FILE"

    git add docs/CANON "$HASH_FILE"
    git commit -m "$VERSION — freeze canon"

    git tag -a "$VERSION" -m "FASS Canon $VERSION"

    echo "$VERSION" > canon/ACTIVE_CANON
    git add canon/ACTIVE_CANON
    git commit -m "Activate $VERSION"

    echo "→ Canon frozen and activated: $VERSION"
    ;;

  witness)
    case "${ARG:-}" in
      tail)
        tail -5 canon/WITNESS_LOG.jsonl
        ;;
      *)
        die "Unknown witness command"
        ;;
    esac
    ;;

  *)
    die "Unknown fass command"
    ;;
esac
